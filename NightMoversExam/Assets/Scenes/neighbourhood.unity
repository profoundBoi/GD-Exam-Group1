      propertyPath: eventSystem
      value: 
      objectReference: {fileID: 1377167396}
    - target: {fileID: 6428940651312042302, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: 'missionTexts.Array.data[0]'
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6428940651312042302, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: 'missionTexts.Array.data[1]'
      value: "You'll be working three jobs tonight. The first house is 29 Brakers
        Road. Client says  other movers bailed. Didn't say why. Doesn't matter we
        don't ask questions. Same rules as  always: don't damage anything, or it
        comes out of your pay. I'll send the list through. Stick to it.  And if something
        feels off in there\u2026 just keep moving"
      objectReference: {fileID: 0}
    - target: {fileID: 6428940651312042302, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: 'missionTexts.Array.data[2]'
      value: 'Don''t stop to look."This call serves as the  player''s introduction
        to the world, the company''s culture, and the rules they will follow for
        the  entire game. The salary system and checklist mechanic are established
        here so that players  understand the stakes before they enter the first house.
        The call''s ominous undertone is  deliberate. '
      objectReference: {fileID: 0}
    - target: {fileID: 6428940651312042302, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: 'missionTexts.Array.data[3]'
      value: ' Lines like "Client says other movers bailed. Didn''t say why" and
        "if something feels  off, just keep moving" signal that something is wrong
        without explaining what. This withholding  of information is important: players
        are warned but not briefed, which means they enter the '
      objectReference: {fileID: 0}
    - target: {fileID: 8326172873565854308, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: m_text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8718440401406302139, guid: 0a43f4c68797e3549bfeae42b9993b40, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
